# V3-LOCAL-INFRA-001: placeholders only; never copy the legacy checkout's .env.
# Future runtime use requires separate authorization and new synthetic credentials.
COMPOSE_PROJECT_NAME=neshane-v3li001-yourname
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_DEV_BOOTSTRAP_PASSWORD
POSTGRES_APP_PASSWORD=REPLACE_WITH_DIFFERENT_DEV_APP_PASSWORD
RABBITMQ_USER=REPLACE_WITH_DEV_MANAGEMENT_USER
RABBITMQ_PASSWORD=REPLACE_WITH_DEV_MANAGEMENT_PASSWORD
GRAFANA_ADMIN_USER=REPLACE_WITH_DEV_GRAFANA_USER
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_DEV_GRAFANA_PASSWORD

# Experimental file only; unused by compose.yaml alone. OD-017 remains OPEN.
SEAWEEDFS_ACCESS_KEY=REPLACE_WITH_SYNTHETIC_S3_ACCESS_KEY
SEAWEEDFS_SECRET_KEY=REPLACE_WITH_SYNTHETIC_S3_SECRET_KEY
SEAWEEDFS_ADMIN_USER=REPLACE_WITH_DEV_SEAWEED_USER
SEAWEEDFS_ADMIN_PASSWORD=REPLACE_WITH_DEV_SEAWEED_PASSWORD

# Default host ports; change for concurrent workspaces. Redis/Tempo are internal.
POSTGRES_PORT=15432
RABBITMQ_AMQP_PORT=15673
RABBITMQ_UI_PORT=25672
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
OTLP_GRPC_PORT=14317
OTLP_HTTP_PORT=14318
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
SEAWEEDFS_S3_PORT=18333
